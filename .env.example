# Copy this file to .env.local and fill in your own Supabase project's values.
# Get them from: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contact form: free access key from https://web3forms.com (sent to your email).
# Without it the form falls back to opening the visitor's email app (mailto:).
VITE_WEB3FORMS_KEY=
